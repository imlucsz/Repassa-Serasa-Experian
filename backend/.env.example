# RePassa backend environment — safe placeholders only, never commit real .env.
# Copy to .env for local development. All secrets must be >=32 random chars in real envs.

NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# PostgreSQL (local disposable defaults match docker-compose.yml and CI).
DATABASE_URL=postgresql://repassa_local:repassa_local@localhost:5432/repassa_local
# Used by test:e2e when set; otherwise an embedded disposable Postgres is started.
TEST_DATABASE_URL=postgresql://repassa_ci:repassa_ci@127.0.0.1:5432/repassa_ci

# Comma-separated browser origins allowed for credentialed requests (CSRF origin check).
# Production must set this explicitly to the deployed UI origin.
ALLOWED_ORIGINS=http://localhost:3000

# Trust X-Forwarded-* only behind a known reverse proxy; never 'true' on a public listener.
TRUST_PROXY=false

# Swagger UI at /api/docs. Defaults to enabled outside production; set false to disable.
SWAGGER_ENABLED=true

LOG_LEVEL=info

# --- Auth (DEV-02) ---
# HS256 access-token secret: >=32 random chars. REQUIRED in production.
# Unset in dev/test -> ephemeral per-process key (sessions die on restart).
# JWT_ACCESS_SECRET=replace-with-64-hex-random-chars-min-32
# ACCESS_TOKEN_TTL_SECONDS=900   # 15 min, range 60-3600
# REFRESH_TOKEN_TTL_DAYS=7       # range 1-90
# Refresh cookie Secure attribute: forced true in production; enable for local HTTPS.
# COOKIE_SECURE=false

# --- Uploads (DEV-03/DEV-05) ---
# Object persistence driver: "local" (ephemeral disk, dev/test only — refused
# in production) or "supabase" (durable private bucket, required in production).
# STORAGE_DRIVER=local
# Local private object-store directory; never under a public/static root.
# UPLOAD_DIR=storage/uploads
# Required when STORAGE_DRIVER=supabase — server-only, never exposed to clients.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-min-32-chars
# SUPABASE_STORAGE_BUCKET=repassa-uploads   # private bucket; create manually in dashboard

# --- Reserved for DEV-04 pickup codes ---
# PICKUP_CODE_SECRET=replace-with-64-hex-random-chars-min-32

# --- Seed (opt-in demo credentials; unset => accounts get random unusable passwords) ---
# SEED_DEMO_PASSWORD=
