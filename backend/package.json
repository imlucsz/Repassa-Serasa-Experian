{
  "name": "repassa-backend",
  "version": "0.1.0",
  "private": true,
  "description": "RePassa API — NestJS + Fastify + Prisma + PostgreSQL modular monolith",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest.unit.config.js",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config test/jest.e2e.config.js --runInBand --forceExit",
    "test:ci": "npm run test && npm run test:e2e",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.1"
    }
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.8",
    "@fastify/static": "^10.1.10",
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-fastify": "^12.5.1",
    "@nestjs/swagger": "^12.1.2",
    "@prisma/client": "~6.19.3",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.8",
    "jose": "6.2.17",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "embedded-postgres": "16.16.0-beta.19",
    "jest": "^30.5.2",
    "prisma": "~6.19.3",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
