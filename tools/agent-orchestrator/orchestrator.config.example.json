{
  "$schema": "./config/orchestrator.schema.json",
  "version": 1,
  "safety": {
    "mode": "read-only",
    "egress": { "onSecret": "block", "maxContextBytes": 131072, "maxFileBytes": 32768 },
    "localhostOnly": true,
    "maxDelegationDepth": 1,
    "executeModelCommands": false
  },
  "gateway": {
    "type": "openai-compatible",
    "baseUrl": "http://127.0.0.1:20128/v1",
    "apiKeyEnv": "OMNIROUTE_API_KEY",
    "adminBaseUrl": "http://127.0.0.1:20128",
    "timeoutSec": 60,
    "maxTimeoutSec": 300,
    "maxRetries": 0
  },
  "budget": {
    "dailyTokens": 200000,
    "dailyCostUsd": 0,
    "perTaskMaxOutputTokens": 4096
  },
  "concurrency": { "maxParallel": 3, "perProvider": 2 },
  "stateDir": "%LOCALAPPDATA%/RepassaOrchestrator/state",
  "repoRoot": "../..",
  "rolesFile": "./roles.json",
  "routing": {
    "defaultProfile": "free-only",
    "profiles": {
      "free-only": { "billing": ["free"] },
      "auto": { "billing": ["free", "paid"] }
    },
    "roleModels": {
      "researcher": ["groq/openai/gpt-oss-20b", "gemini/gemini-3.1-flash-lite"],
      "ux-reviewer": ["gemini/gemini-3.1-flash-lite", "groq/qwen/qwen3.8-27b"],
      "qa-reviewer": ["groq/qwen/qwen3.8-27b", "gemini/gemini-3.1-flash-lite"],
      "backend-reviewer": ["groq/openai/gpt-oss-120b", "gemini/gemini-3.1-flash-lite"],
      "frontend-implementer": ["groq/openai/gpt-oss-120b"]
    }
  },
  "providers": [
    {
      "id": "example-free-provider",
      "billing": "free",
      "note": "Replace with a provider YOU authorized. Free quota is conditional - dailyTokens is the rate limit.",
      "models": [{ "id": "example/model-id", "capabilities": ["text", "code"] }],
      "envKey": "EXAMPLE_PROVIDER_KEY"
    },
    {
      "id": "example-paid-provider",
      "billing": "paid",
      "note": "Callable ONLY by explicit model/provider selection under a profile that lists 'paid'. Never auto-routed.",
      "maxDailyCostUsd": 0.5,
      "pricing": { "inputPerMToken": 0.15, "outputPerMToken": 0.6 },
      "models": [{ "id": "example/paid-model", "capabilities": ["text", "code"] }]
    }
  ],
  "workers": {
    "enabled": false,
    "worktreeRoot": "%LOCALAPPDATA%/RepassaOrchestrator/worktrees",
    "branchPrefix": "worker/",
    "allowedPathPrefixes": ["src/", "docs/", "tests/", "public/"],
    "deniedPathGlobs": [".env*", "**/*.key", "**/*.pem", "**/secrets/**", "video/**", "node_modules/**", "backend/storage/**", ".codex/**"]
  }
}
