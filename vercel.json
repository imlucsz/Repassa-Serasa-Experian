{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/preview/home-cinematica",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "cache-control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://repassa-serasa-experian.onrender.com/api/v1/:path*"
    },
    {
      "source": "/api/docs",
      "destination": "https://repassa-serasa-experian.onrender.com/api/docs"
    },
    {
      "source": "/api/docs/:path*",
      "destination": "https://repassa-serasa-experian.onrender.com/api/docs/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
